+/* MOV Vd.16B, Vn.16B. Scalar FMOV cannot copy a 128-bit real. */
+@trusted
+private void moveQuad(ref CodeBuilder cdb, reg_t to, reg_t from)
+{
+    if (to != from)
+        cdb.gen1(INSTR.mov_orr_advsimd_reg(1, from, to));
