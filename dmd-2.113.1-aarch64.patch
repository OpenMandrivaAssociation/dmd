+
+/********************************
+ * Place 128-bit float arguments in the AAPCS registers.
+ * __addtf3/__subtf3/__multf3/__divtf3 take the left operand in v0 and the
+ * right in v1. src1 == NOREG is a unary call (argument in v0 only).
+ * v0 and v1 are caller-saved, so this must run after getregs() has spilled
+ * anything still live there and before the BL.
+ */
+@trusted
+private void placeQuadArgs(ref CodeBuilder cdb, reg_t src0, reg_t src1)
+{
+    enum v0 = 32;
+    enum v1 = 33;
+    if (src1 == NOREG)
+    {
+        moveQuad(cdb, v0, src0);
+        return;
+    }
+
+    // left in v1 and right in v0: neither can be moved without a temporary.
+    if (src0 == v1 && src1 == v0)
+    {
+        regm_t tmpm = INSTR.FLOATREGS & ~mask(v0) & ~mask(v1);
+        reg_t tmp = allocreg(cdb, tmpm, TYreal);
+        moveQuad(cdb, tmp, v0);
+        moveQuad(cdb, v0, v1);
+        moveQuad(cdb, v1, tmp);
+        return;
+    }
+
+    bool leftInV0 = src0 == v0;
+    bool rightInV1 = src1 == v1;
+    // Evacuate a value that occupies the other argument's register first.
+    if (src1 == v0)
+    {
+        moveQuad(cdb, v1, src1);
+        rightInV1 = true;
+    }
+    if (src0 == v1)
+    {
+        moveQuad(cdb, v0, src0);
+        leftInV0 = true;
+    }
+    if (!leftInV0)
+        moveQuad(cdb, v0, src0);
+    if (!rightInV1)
+        moveQuad(cdb, v1, src1);
+}
