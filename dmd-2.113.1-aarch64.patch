+/****************************************
+ * Store a host `real` as IEEE binary128 little-endian bytes.
+ * Linux AArch64 long double is binary128. An x86 host `real` is x87
+ * (64-bit explicit mantissa, bias 16383). Copying those 10 bytes makes
+ * `__multf3` read a denormal and return 0. Binary128 uses the same
+ * exponent bias; the explicit integer bit is dropped and the fraction
+ * is placed at the top of the 112-bit field.
+ */
+void hostRealToIEEE128(real x, ref ubyte[16] dst) @trusted nothrow @nogc
+{
+    static if (real.mant_dig == 113 && real.sizeof == 16)
+    {
+        // Host real is already binary128 (LDC on AArch64).
+        memcpy(dst.ptr, &x, 16);
+    }
+    else static if (real.mant_dig == 64)
+    {
+        ubyte[10] raw = void;
+        memcpy(raw.ptr, &x, 10);
+        ulong mant;
+        ushort expSign;
+        memcpy(&mant, raw.ptr, 8);
+        memcpy(&expSign, raw.ptr + 8, 2);
+
+        const uint sign = expSign >> 15;
+        int exp = expSign & 0x7FFF;
+        ulong lo, hi;
+        if (exp == 0x7FFF)
+        {
+            const ulong frac = mant & 0x7FFF_FFFF_FFFF_FFFF;
+            lo = frac << 49;
+            hi = (cast(ulong)sign << 63) | (0x7FFFUL << 48) | (frac >> 15);
+            if (frac)
+                hi |= 1UL << 47;            // quiet NaN
+        }
+        else if (mant == 0)
+        {
+            lo = 0;
+            hi = cast(ulong)sign << 63;     // +0 or -0
+        }
+        else
+        {
+            if (exp == 0)
+                exp = 1;                    // x87 denormal, integer bit clear
+            while (mant && (mant & (1UL << 63)) == 0 && exp > 0)
+            {
+                mant <<= 1;
+                --exp;
+            }
+            if (exp <= 0 || (mant & (1UL << 63)) == 0)
+            {
+                // Smaller than a binary128 normal. Flush; compiler constants
+                // of this magnitude are not produced for the values we emit.
+                lo = 0;
+                hi = cast(ulong)sign << 63;
+            }
+            else
+            {
+                const ulong frac = mant & 0x7FFF_FFFF_FFFF_FFFF;
+                lo = frac << 49;
+                hi = (cast(ulong)sign << 63) | (cast(ulong)exp << 48) | (frac >> 15);
+            }
+        }
+        ulong[2] words = [lo, hi];
+        memcpy(dst.ptr, words.ptr, 16);
+    }
+    else
+        static assert(0, "host real is neither x87 nor binary128");
+}
